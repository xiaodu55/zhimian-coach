{
  "name": "zhimian-coach-monorepo",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "npm run dev --workspace @zhimian/bff",
    "build:bank": "npm run start --workspace @zhimian/build-bank",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev:port": "npm run dev:port --workspace @zhimian/bff",
    "build:bff": "npm run build --workspace @zhimian/bff",
    "start": "node scripts/dev/start-prod.mjs",
    "bank:questions": "node scripts/build-bank/questions.mjs",
    "bank:cards": "node scripts/build-bank/cards.mjs",
    "bank:to-v02": "node scripts/build-bank/to-v02.mjs",
    "bank:full": "node scripts/build-bank/questions.mjs && node scripts/build-bank/cards.mjs && node scripts/build-bank/to-v02.mjs",
    "test": "npm run test --workspace @zhimian/bff",
    "dev:restart": "node scripts/dev/restart.mjs",
    "build:all": "npm run build --workspace @zhimian/bff",
    "tunnel": "node scripts/dev/tunnel.mjs",
    "verify:deploy": "node scripts/test/smoke.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@botharness/cloudflared-win32-x64": "^1.7.0",
    "playwright-core": "^1.65.1"
  },
  "workspaces": [
    "apps/*",
    "scripts/*"
  ],
  "engines": {
    "node": "20"
  }
}
