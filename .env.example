# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，不会入库
# ---------------------------------------------------------------
# 必填：知乎开放平台 Access Secret（developer.zhihu.com/profile 生成）
ZHIHU_ACCESS_SECRET=

# 必填：模型服务（OpenAI 兼容端点）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 选填
PORT=8787
NODE_ENV=development
CACHE_TTL_HOURS=24
DEVICE_SALT=change-me-random-string

# 功能开关（1 开启 / 0 关闭）
FEATURE_PDF=1
FEATURE_OAUTH=0
FEATURE_ASR=0

# 仅供客户端读取的公开值（非密钥）
BFF_BASE_URL=
